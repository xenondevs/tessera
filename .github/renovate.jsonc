{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "local>xenondevs/renovate"
    ],
    "enabledManagers": [
        "github-actions",
        "cargo",
        "gradle",
        "gradle-wrapper",
        "mise",
        "rust-toolchain",
        "custom.regex"
    ],
    "customManagers": [
        {
            "description": "manylinux container images in release.yml",
            "customType": "regex",
            "managerFilePatterns": [
                "/(^|/)\\.github/workflows/release\\.ya?ml$/"
            ],
            "matchStrings": [
                "'(?<depName>quay\\.io/pypa/manylinux_2_28_[^:]+):(?<currentValue>[^@]+)@(?<currentDigest>sha256:[0-9a-f]{64})'"
            ],
            "datasourceTemplate": "docker"
        }
    ],
    "packageRules": [
        {
            "matchManagers": ["custom.regex"],
            "matchDatasources": ["docker"],
            "groupName": "manylinux",
            "semanticCommitScope": "ci"
        },
        {
            // one branch per minecraft port
            "groupName": "minecraft",
            "matchPackageNames": ["/^net\\.fabricmc/", "/^net\\.neoforged/", "/^org\\.jetbrains\\.kotlin/"]
        },
        {
            "matchPackageNames": ["/^net\\.fabricmc/", "/^net\\.neoforged/"],
            "minimumReleaseAge": null
        },
        { "matchPackageNames": ["/^net\\.fabricmc/"], "registryUrls": ["https://maven.fabricmc.net/"] },
        {
            // prevent the minecraft version from being bumped
            "matchPackageNames": ["net.fabricmc.fabric-api:fabric-api"],
            "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+(?<compatibility>.+)$"
        },
        // file:size is a misparse of listOf("file", "size", "sha256") in build.gradle.kts
        { "matchPackageNames": ["com.mojang:minecraft", "file:size"], "enabled": false }
    ]
}
